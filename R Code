# Fit linear model: Pooled OLS
model <- lm(inv ~ value + capital, data = Grunfeld)

# Extract model info
n <- nobs(model)        # 200 observations
p <- length(coef(model)) # 3 (intercept, value, capital)

# Compute all diagnostics
diagnostics <- tibble(
  obs = 1:n,
  firm = Grunfeld$firm,
  year = Grunfeld$year,
  invest = Grunfeld$invest,
  value = Grunfeld$value,
  capital = Grunfeld$capital,
  
  # 1. Leverage (hat values)
  leverage = hatvalues(model),
  
  # 2. Internally Studentized Residuals
  stud_res = rstandard(model),
  
  # 3. Externally Studentized Residuals
  stud_res_ext = rstudent(model),
  
  # 4. Mahalanobis Distance (in X-space, excluding intercept)
  X = model.matrix(model)[, -1],  # predictors only
  mahal_dist = mahalanobis(X, colMeans(X), cov(X)),
  
  # 5. Cook's Distance
  cook_dist = cooks.distance(model),
  
  # 6. DFFITS
  dffits = dffits(model),
  
  # 7. DFBETAS (for each coefficient; we'll focus on intercept, value, capital)
  dfbetas_int = dfbetas(model)[, "(Intercept)"],
  dfbetas_value = dfbetas(model)[, "value"],
  dfbetas_capital = dfbetas(model)[, "capital"],
  
  # 8. Atkinson’s Measure (scaled Cook’s distance)
  # Recompute Atkinson's measure safely
  
  # First, inspect Cook's distances near or above 1
  cook_dist <- cooks.distance(model)
  
  # Find any Cook's distance >= 1
  if (any(cook_dist >= 1, na.rm = TRUE)) {
    cat("Warning: The following observations have Cook's distance >= 1:\n")
    print(which(cook_dist >= 1))
    print(data.frame(obs = which(cook_dist >= 1),
                     cook_dist = cook_dist[cook_dist >= 1],
                     firm = Grunfeld$firm[cook_dist >= 1],
                     year = Grunfeld$year[cook_dist >= 1]))
  }
  
  # Safe computation of Atkinson’s measure
  atkinson_safe <- ifelse(cook_dist >= 1, 
                          Inf,  # undefined or infinite influence
                          sqrt(p * cook_dist / (1 - cook_dist) * (n - p) / p)
  )
  # 9. COVRATIO
  covratio = covratio(model)
) %>%
  select(-X)  # remove temporary X column

# Thresholds
thresh_leverage   <- 2 * p / n
thresh_stud_ext   <- qt(0.975, df = n - p - 1)  # ~1.97
thresh_cook       <- 4 / n
thresh_dffits     <- 2 * sqrt(p / n)
thresh_dfbetas    <- 2 / sqrt(n)
thresh_mahal      <- qchisq(0.975, df = p - 1)  # p-1 = 2
thresh_atkinson   <- qf(0.975, p, n - p)        # for comparison
thresh_covratio_low  <- 1 - 3 * p / n
thresh_covratio_high <- 1 + 3 * p / n

# Add outlier flags
diagnostics <- diagnostics %>%
  mutate(
    outlier_leverage   = leverage > thresh_leverage,
    outlier_stud_ext   = abs(stud_res_ext) > thresh_stud_ext,
    outlier_cook       = cook_dist > thresh_cook,
    outlier_dffits     = abs(dffits) > thresh_dffits,
    outlier_dfbetas    = (abs(dfbetas_int) > thresh_dfbetas |
                            abs(dfbetas_value) > thresh_dfbetas |
                            abs(dfbetas_capital) > thresh_dfbetas),
    outlier_mahal      = mahal_dist > thresh_mahal,
    outlier_atkinson   = atkinson > thresh_atkinson,
    outlier_covratio   = covratio < thresh_covratio_low | covratio > thresh_covratio_high,
    
    # Count how many methods flag this obs
    total_flags = rowSums(select(., 
                                 outlier_leverage, outlier_stud_ext, outlier_cook, 
                                 outlier_dffits, outlier_dfbetas, 
                                 outlier_mahal, outlier_atkinson, outlier_covratio
    ))
  )


# Select only columns of interest for final comparison
comparison_table <- diagnostics %>%
  select(
    obs, firm, year, invest, value, capital,
    leverage, stud_res_ext, mahal_dist, cook_dist, 
    dffits, dfbetas_value, atkinson, covratio,
    outlier_leverage, outlier_stud_ext, outlier_mahal,
    outlier_cook, outlier_dffits, outlier_dfbetas,
    outlier_atkinson, outlier_covratio, total_flags
  ) %>%
  filter(total_flags > 0) %>%  # Only show observations flagged by at least one method
  arrange(desc(total_flags), -cook_dist) %>%
