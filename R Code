### COVRATIO

# Get leave-one-out fits
influence_stats <- influence(model)

# Number of parameters (including intercept)
p <- length(coef(model))  # p = 3
n <- nrow(Grunfeld)

# Hat values (leverage)
h_ii <- influence_stats$hat

# Residuals
residuals_std <- residuals(model)
sigma_sq <- sum(residuals(model)^2) / (n - p)  # MSE

# Leave-one-out residual variance
sigma_i_sq <- rep(NA, n)
for (i in 1:n) {
  model_i <- lm(update(formula(model), data = Grunfeld[-i, ]))
  sigma_i_sq[i] <- sum(residuals(model_i)^2) / (n - p - 1)
}

# Alternatively, use approximation from hat values and residuals
# More efficient: Use analytical formula for COVRATIO
covratio <- ( ( (n - p - residuals(model)^2 / (1 - h_ii)^2 * (1/(n - p)) ) / (n - p) )^(-p/2) ) * 
  ((1 - h_ii)^2)

# But better: Use standard formula:
# COVRATIO_i = [det(Σ_{-i}) / det(Σ)] 
# Approximated by: COVRATIO_i = [(n-p-1 + r_i^2/(1-h_ii)^2)/(n-p)]^p * (1 - h_ii)^2 / (1 - h_ii)^2 → simplified

# Standard formula used in textbooks:
covratio <- (( (summary(model)$sigma^2 * (n - p) - residuals(model)^2 / (1 - h_ii)^2 ) / (n - p - 1) ) / 
               summary(model)$sigma^2)^p * (1 - h_ii)^p

# Actually, most sources use this simplified approximation:
covratio <- ( ( (n - p - 1) / ( (n - p - (residuals(model)/(1 - h_ii))^2 / summary(model)$sigma^2 ) ) )^(p/2) ) * (1 - h_ii)^p

# Let's use the **most accepted and simple formula**:
# COVRATIO_i = [ (MSE_{-i}) / MSE ]^p * (1 - h_ii)^p
# But we can get it via `influence.measures()` which provides it directly!

inf <- influence.measures(model)

# COVRATIO is part of inf$infmat
# Column name: "covratio"
df <- data.frame(
  obs = 1:n,
  firm = Grunfeld$firm,
  year = Grunfeld$year,
  covratio = inf$infmat[, "covratio"]
)

threshold_low <- 1 - (3 * p / n)
threshold_high <- 1 + (3 * p / n)

cat("COVRATIO thresholds:\n")
cat("Lower: ", round(threshold_low, 3), "\n")
cat("Upper: ", round(threshold_high, 3), "\n")
# For Grunfeld: n=200, p=3 → thresholds: 1 ± 9/200 → [0.955, 1.045]

# Add flag for influential points
